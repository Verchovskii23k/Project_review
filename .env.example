# База данных
# Строка подключения к PostgreSQL.
# Формат: postgresql://пользователь:пароль@хост:порт/база
DATABASE_URL=postgresql://postgres:ваш_пароль@localhost:5432/ваша_база_данных

# ────────────────────────────────────────────────────────────────────────────────────

# Порт для сервера (по умолчанию 3000)
PORT=3000

# ────────────────────────────────────────────────────────────────────────────────────

# Аутентификация Better Auth
# Публичный URL вашего приложения (используется для callback-маршрутов,
# формирования ссылок в письмах и определения базового пути).
# Номера портов должны совпадать
BETTER_AUTH_URL=http://localhost:3000

# (Опционально) Секретный ключ для Better Auth.
# Если не задан, генерируется автоматически при первом запуске.
# Для продакшена обязательно задайте случайную строку длиной не менее 32 символов.
# BETTER_AUTH_SECRET=ваш_секретный_ключ

# ────────────────────────────────────────────────────────────────────────────────────

# Почтовый сервер (SMTP)
# Используется для отправки писем: восстановление пароля, выдача учётных данных.
#
# Локальный почтовый сервер (Mailpit)
# Все письма перехватываются и доступны в веб-интерфейсе Mailpit (http://localhost:8025).
# Письма не уходят в реальный мир.
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_FROM="Расписание университета <no-reply@example.com>"

# ────────────────────────────────────────────────────────────────────────────────────

# Реальный SMTP (mail.ru)
# Раскомментируйте и заполните для отправки настоящих писем.
# SMTP_HOST=smtp.mail.ru
# SMTP_PORT=587
# SMTP_USER=ваша_почта@mail.ru
# SMTP_PASS=пароль_приложения
# SMTP_FROM="Расписание университета <ваша_почта@mail.ru>"