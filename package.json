{
  "name": "cursovoy",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "dev:test": "dotenv -e .env.test -- next dev",
    "build": "next build",
    "start": "next start",
    "db:generate": "npx drizzle-kit generate",
    "db:push": "npx drizzle-kit push",
    "db:migrate": "drizzle-kit migrate",
    "type-check": "tsc --noEmit",
    "lint": "eslint src --ext .ts,.tsx",
    "lint:fix": "eslint src --ext .ts,.tsx --fix",
    "test:db:push": "dotenv -e .env.test -- drizzle-kit push",
    "test": "vitest run --exclude 'e2e/**'",
    "test:e2e:auth": "npx playwright test e2e/auth-setup.spec.ts",
    "test:e2e:mail": "npx playwright test e2e/password-reset-mail.spec.ts",
    "test:e2e": "npx playwright test",
    "seed": "npx dotenv -e .env -- npx tsx src/db/seed.ts"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@tanstack/react-query": "^5.80.3",
    "@tanstack/react-table": "^8.21.3",
    "@trpc/client": "^11.16.0",
    "@trpc/next": "^11.16.0",
    "@trpc/react-query": "^11.16.0",
    "@trpc/server": "^11.16.0",
    "autoprefixer": "^10.5.0",
    "bcryptjs": "^3.0.3",
    "better-auth": "^1.6.11",
    "cookie": "^1.1.1",
    "dotenv": "^17.4.2",
    "drizzle-kit": "^0.31.10",
    "drizzle-orm": "^0.45.2",
    "lucide-react": "^1.14.0",
    "next": "^15.5.0",
    "next-themes": "^0.4.6",
    "nodemailer": "^8.0.7",
    "postcss": "^8.5.12",
    "postgres": "^3.4.9",
    "react": "^19.2.5",
    "react-dom": "^19.2.5",
    "sonner": "^2.0.7",
    "uuid": "^14.0.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@playwright/test": "^1.60.0",
    "@tailwindcss/postcss": "^4",
    "@types/bcryptjs": "^2.4.6",
    "@types/cookie": "^0.6.0",
    "@types/node": "^20",
    "@types/nodemailer": "^8.0.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19",
    "@types/uuid": "^10.0.0",
    "@typescript-eslint/eslint-plugin": "^8.59.2",
    "@typescript-eslint/parser": "^8.59.2",
    "@vitejs/plugin-react": "^4.7.0",
    "dotenv-cli": "^11.0.0",
    "eslint": "^9.39.4",
    "eslint-config-next": "^16.2.4",
    "eslint-plugin-tailwindcss": "^3.18.3",
    "jsdom": "^27.0.1",
    "tailwindcss": "^3.4.17",
    "typescript": "^5",
    "vitest": "^4.1.6"
  }
}
